return function()
    local ALLOWED = {
        ["Pistol"] = true,
        ["Explosive"] = true,
        ["Detonator"] = true,
        ["Sledge"] = true,
        ["Plank"] = true,
        ["Lantern"] = true
    }

    local function filterLoadout(player)
        local backpack = player:FindFirstChild("Backpack")
        local UserInputService = game:GetService("UserInputService")
        
        -- Проверяем, что игрок на ПК (нет сенсорного ввода)
        if backpack and not UserInputService.TouchEnabled then
            for _, item in ipairs(backpack:GetChildren()) do
                if not ALLOWED[item.Name] then
                    item:Destroy()
                end
            end
        end
    end

    game.Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
            filterLoadout(player)
        end)
    end)
end
{
    "Name": "Horror Mod",
    "Description": "Restricts PC player loadout for horror mode",
    "Author": "bibuskas",
    "Version": "1.0.0",
    "Main": "main.lua"
}
